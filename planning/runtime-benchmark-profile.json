{
  "format": "tessryn-runtime-benchmark-profile/v1",
  "scope": "repeated_qemu_runtime_observations",
  "independent_repeats": 2,
  "preemption": {
    "scenarios": [
      "preemption",
      "budget",
      "deadline",
      "forged_irq"
    ],
    "samples": "all_accepted_actual_irq_endpoints",
    "warmup_samples": 0,
    "counter": "hpet64",
    "period_fs": 10000000,
    "time_domain": "qemu_emulator_virtual_time",
    "pool_boots": false
  },
  "contention": {
    "profile": "planning/contention-benchmark-profile.json",
    "cases": 6,
    "samples_per_case": 16,
    "warmup_per_case": 4,
    "iterations": 1024,
    "counter": "bsp_hpet64",
    "pool_boots": false
  },
  "host_intermediate_cleanup": {
    "policy": "fixed_owned_regular_files_after_success",
    "files": [
      "libtessryn_scheduler.rlib",
      "scheduler-tests",
      "adapter-tests",
      "driver-tests"
    ],
    "maximum_file_bytes": 67108864,
    "require_single_link": true,
    "unknown_files": "preserved_for_inventory_rejection"
  },
  "limits": {
    "wall_seconds": 1800,
    "stage_cleanup_grace_seconds": 3.5,
    "stage_log_bytes": 1048576,
    "public_bytes": 2147483648,
    "public_files": 2048
  },
  "comparison": {
    "identity": "exact_source_build_runtime_machine_clock_profile",
    "statistics": "within_boot_only",
    "overhead_subtraction": false,
    "performance_threshold": null,
    "promotion_decision": false
  },
  "capture_authentication": "unverified_offline",
  "hardware_qualified": false,
  "inference_qualified": false
}
